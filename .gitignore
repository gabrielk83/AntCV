# Wrangler / Cloudflare
.wrangler/
.dev.vars
wrangler.toml.bak

# The Cloudflare GitHub bot (cloudflare-workers-and-pages[bot]) periodically
# pushes a /wrangler.jsonc at the repo root that says name="docx-worker" and
# assets={directory:"pwa"}. That file HIJACKS `wrangler deploy` from every
# worker subdirectory — wrangler walks up, finds it, and uploads docx-worker
# instead of whatever worker you cd'd into. See scripts/git-hooks/pre-commit
# for the matching commit guard. Per-worker wrangler.toml files are NOT
# affected; this glob is root-anchored.
/wrangler.jsonc

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.dev.vars
# Environment
.env
.env.local
.env.*.local

# Build artefacts
dist/
build/

# Browser-QA run artefacts (regenerated by `npm run qa:browser`)
docs/qa/last-browser-qa.json
docs/qa/screenshots/
test-results/
*.tsbuildinfo
.vite/

# Vite library-mode output lands inside pwa/ alongside the vanilla files
# (so `wrangler pages deploy pwa/` is unchanged). We DO commit the built
# bundle so deploys don't require a build step on Cloudflare. Source lives
# in /src/; the built /pwa/antcv-react-islands.js* is tracked.

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Backups
*.bak
*.orig

# Word / Office lock files (open-document temp files)
~$*.docx
~$*.docm
~$*.xlsx
~$*.pptx

# Logs
*.log

# Test output
coverage/
.nyc_output/
# DOCX worker smoke tests write a one-shot out.docx for manual inspection.
workers/docx-worker/out.docx
# Vite emits a source map next to the islands bundle; the bundle ships, the map does not.
pwa/antcv-react-islands.js.map

# Local-only secrets / candidate data
secrets/
private/
candidates/

.dev.vars*
!.dev.vars.example
!.env.example

.claude/worktrees/

pwa/antcv-react-islands.js.map
