{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AntCV Visual Package Registry",
  "description": "Seven locked packages from docs/design/Unified_Visual_Package_System.docx. Consumed by both the PWA (packages/registry.css) and the DOCX worker.",
  "type": "object",
  "required": ["version", "default", "packages"],
  "properties": {
    "version": { "type": "string" },
    "source": { "type": "string" },
    "planRef": { "type": "string" },
    "default": { "type": "string", "enum": ["copenhagen-modern", "navy-executive", "warm-terracotta", "nordic-frost", "pampas-contemporary", "tokyo-precision", "delhi-technical"] },
    "packages": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/Package" },
      "required": ["copenhagen-modern", "navy-executive", "warm-terracotta", "nordic-frost", "pampas-contemporary", "tokyo-precision", "delhi-technical"]
    },
    "globalSemanticTokens": { "type": "array", "items": { "type": "string" } },
    "atsRules": { "type": "object" },
    "allowedBullets": { "type": "array", "items": { "type": "string" } },
    "allowedContactGlyphs": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "Hex": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
    "AltPair": {
      "type": "object",
      "required": ["head", "sidebar"],
      "properties": {
        "head": { "$ref": "#/$defs/Hex" },
        "sidebar": { "$ref": "#/$defs/Hex" }
      }
    },
    "Package": {
      "type": "object",
      "required": ["displayName", "base", "primary", "interactive", "bullet", "glyph", "headingFont", "bodyFont", "shape", "imageSize", "alt1", "alt2", "dark"],
      "properties": {
        "displayName": { "type": "string" },
        "base": { "$ref": "#/$defs/Hex" },
        "primary": { "$ref": "#/$defs/Hex" },
        "interactive": { "$ref": "#/$defs/Hex" },
        "bullet": { "$ref": "#/$defs/Hex" },
        "glyph": { "$ref": "#/$defs/Hex" },
        "headingFont": { "type": "string" },
        "bodyFont": { "type": "string" },
        "shape": { "type": "string", "enum": ["circle", "rounded", "rounded-square", "square", "hexagon"] },
        "shapeSecondary": { "type": "string", "enum": ["circle", "rounded", "rounded-square", "square", "hexagon"] },
        "imageSize": { "type": "integer", "minimum": 40, "maximum": 200 },
        "alt1": { "$ref": "#/$defs/AltPair" },
        "alt2": { "$ref": "#/$defs/AltPair" },
        "dark": {
          "type": "object",
          "required": ["alt1", "alt2"],
          "properties": {
            "alt1": { "$ref": "#/$defs/AltPair" },
            "alt2": { "$ref": "#/$defs/AltPair" }
          }
        }
      }
    }
  }
}
