#!/usr/bin/env sh
# AntCV pre-commit guard
#
# Blocks two known-bad situations:
#
# 1. Root /wrangler.jsonc — the Cloudflare GitHub bot
#    (cloudflare-workers-and-pages[bot]) periodically pushes this file. It
#    sets name="docx-worker" and assets={directory:"pwa"}, which hijacks
#    `wrangler deploy` from EVERY worker subdirectory (wrangler walks up,
#    finds it, deploys docx-worker instead of the worker you cd'd into).
#    A 3-day outage in May 2026 was caused by this. Never again.
#
# Install into THIS clone:
#
#   POSIX (macOS / Linux / Git Bash):
#     cp scripts/git-hooks/pre-commit .git/hooks/pre-commit
#     chmod +x .git/hooks/pre-commit
#
#   Windows PowerShell:
#     cp scripts/git-hooks/pre-commit .git/hooks/pre-commit
#     # No chmod — Windows has no exec bit, and Git for Windows runs hooks
#     # via its bundled sh.exe regardless. `chmod` is not a PowerShell cmdlet.

set -e

# Staged files, NUL-separated for safety.
STAGED=$(git diff --cached --name-only --diff-filter=ACMR -z | tr '\0' '\n')

BLOCKED=""

# --- Guard 1: root wrangler.jsonc ---
if printf '%s\n' "$STAGED" | grep -Fxq 'wrangler.jsonc'; then
    BLOCKED="$BLOCKED
  - /wrangler.jsonc at repo root.
    This file is auto-injected by the cloudflare-workers-and-pages[bot] and
    hijacks 'wrangler deploy' from every worker subdirectory by setting
    name=\"docx-worker\" and assets.directory=\"pwa\". It is git-ignored
    on purpose. If you genuinely need a root wrangler config, name it
    something else or use --config explicitly. Per-worker wrangler.toml
    files are fine — this hook only blocks the root path."
fi

if [ -n "$BLOCKED" ]; then
    printf '\n\033[31mpre-commit: refusing to stage the following:\033[0m\n%s\n\n' "$BLOCKED" >&2
    printf 'To bypass (do NOT do this for the Cloudflare bot file):\n' >&2
    printf '  git commit --no-verify\n\n' >&2
    exit 1
fi

exit 0
