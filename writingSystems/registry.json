  "planRef": "docs/plan/AntCV_Plan_v2_LockedSources.md §4",
  "default": "nordic-minimal",
  "activeAtCut": ["nordic-minimal", "achievement-driven", "measured-professional", "structured-professional", "mediterranean-formal", "prestige-structured", "credential-forward", "precision-formal", "context-rich", "cold-outreach", "research-formal", "hybrid-balanced"],
  "densityTiers": {
