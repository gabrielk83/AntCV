    "cold-outreach": {
      "displayName": "Cold Outreach",
      "active": true,
      "primaryConstraint": "possibility framing, brevity",
      "constraintAvoid": "full CV-style density, formal applicant register, credential-dumping, closing pressure",
      "constraintPrefer": "speculative framing, shorter bullets, possibility-led openers, conversational tone",
      "defaultToneChips": ["speculative", "brief", "conversational"],
      "lineDensity": "low",
      "wordsPerBullet": { "min": 8, "max": 14 },
      "profileChars": { "min": 160, "max": 260 },
      "allowedLength": { "min": 1, "max": 2 },
      "sectionFormatDefaults": {
        "profile": "paragraph-short",
        "core_competencies": "omit",
        "selected_outcomes": "bullets-short",
        "experience": "bullets-condensed",
        "certifications": "omit",
        "education": "sidebar-minimal"
