  "integrityRules": [
    {
      "id": "metric-integrity",
      "rule": "Never invent metrics. If a metric is missing, use scope, method, or outcome without numbers."
    },
    {
      "id": "role-boundary-integrity",
      "rule": "Do not imply account, people, or product ownership unless supported. Use 'contributed', 'supported', 'partnered', 'coordinated', or 'led' only when the underlying scope supports the verb."
    },
    {
      "id": "research-evidence-integrity",
      "rule": "Do not compress away publications, thesis, methods, or grants in Research Formal. Academic evidence outranks commercial brevity."
    }
  ],
  "matching": {
    "wordMode": "case-insensitive exact-match",
    "phraseMode": "case-insensitive punctuation-tolerant",
    "sceOrder": "banned-word/phrase filtering runs before trigger-based semantic constraints",
    "retryPolicy": { "maxRetries": 2, "thirdDraftBehaviour": "return-with-flagged-true" }
  },
  "sectionFormatTaxonomy": [
    "default",
    "paragraph",
    "bullets",
    "unicode-bullets",
    "hybrid-1",
    "hybrid-2",
    "hybrid-3",
    "table-grid",
    "structured-grid"
  ]
