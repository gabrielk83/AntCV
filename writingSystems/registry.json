  "toneChipsCatalogue": {
    "calm":                  { "effect": "dampen exclamation, reduce magnitude words", "compatibleWith": "all" },
    "restrained":            { "effect": "shorten sentences, drop qualifiers", "compatibleWith": ["nordic-minimal", "measured-professional", "cold-outreach"] },
    "factual":               { "effect": "strip evaluative adjectives, prefer numbers", "compatibleWith": "all-except", "incompatibleWith": ["context-rich"] },
    "outcome-led":           { "effect": "enforce outcome-first ordering", "compatibleWith": ["achievement-driven", "measured-professional", "prestige-structured"] },
    "quantified":            { "effect": "demand metric in every bullet that has one available", "compatibleWith": ["achievement-driven", "precision-formal", "prestige-structured"] },
    "scope-anchored":        { "effect": "name team size, revenue, geography", "compatibleWith": ["achievement-driven", "prestige-structured"] },
    "balanced":              { "effect": "no register lean", "compatibleWith": ["measured-professional", "hybrid-balanced"] },
    "concrete":              { "effect": "prefer specific nouns over generic", "compatibleWith": "all" },
    "disciplined":           { "effect": "name the method/framework", "compatibleWith": ["structured-professional", "credential-forward"] },
    "method-led":            { "effect": "lead bullets with the method, not the outcome", "compatibleWith": ["structured-professional"] },
    "scope-defined":         { "effect": "state scope explicitly per bullet", "compatibleWith": ["structured-professional", "prestige-structured"] },
    "formal":                { "effect": "raise register", "compatibleWith": ["mediterranean-formal", "prestige-structured", "research-formal"] },
    "warm":                  { "effect": "acknowledge people and context", "compatibleWith": ["mediterranean-formal", "context-rich"] },
    "relational":            { "effect": "frame work as collaboration", "compatibleWith": ["mediterranean-formal", "context-rich"] },
    "institutional":         { "effect": "use organisation-level framing", "compatibleWith": ["prestige-structured"] },
    "polished":              { "effect": "smooth out short clauses", "compatibleWith": ["prestige-structured", "mediterranean-formal"] },
    "scope-heavy":           { "effect": "foreground revenue, headcount, P&L", "compatibleWith": ["prestige-structured"] },
    "credentialed":          { "effect": "surface qualifications inline", "compatibleWith": ["credential-forward", "research-formal"] },
    "accredited":            { "effect": "name accreditation levels explicitly", "compatibleWith": ["credential-forward"] },
    "named-methodology":     { "effect": "cite ISO numbers, Six Sigma levels, etc.", "compatibleWith": ["credential-forward", "structured-professional"] },
    "precise":               { "effect": "exact numbers, no magnitude words", "compatibleWith": ["precision-formal", "achievement-driven"] },
    "technical":             { "effect": "accept technical vocabulary as register", "compatibleWith": ["precision-formal", "structured-professional"] },
    "narrative":             { "effect": "sentence-shaped bullets, paragraph profile", "compatibleWith": ["context-rich", "hybrid-balanced"] },
    "reasoned":              { "effect": "name the why behind each move", "compatibleWith": ["context-rich", "hybrid-balanced"] },
    "why-led":               { "effect": "lead with reasoning, then evidence", "compatibleWith": ["context-rich"] },
    "speculative":           { "effect": "possibility-led framing", "compatibleWith": ["cold-outreach"] },
    "brief":                 { "effect": "aggressive compression", "compatibleWith": ["cold-outreach", "nordic-minimal"] },
    "conversational":        { "effect": "drop applicant register", "compatibleWith": ["cold-outreach"] },
    "academic":              { "effect": "research register, no commercial framing", "compatibleWith": ["research-formal", "hybrid-balanced"] },
    "methodological":        { "effect": "foreground methods over outcomes", "compatibleWith": ["research-formal", "structured-professional"] },
    "publication-anchored":  { "effect": "reference publications in body text", "compatibleWith": ["research-formal"] },
    "bridging":              { "effect": "dual-register signals", "compatibleWith": ["hybrid-balanced"] },
    "dual-register":         { "effect": "accept both registers in same bullet", "compatibleWith": ["hybrid-balanced"] },
    "jd-tuned":              { "effect": "weight register toward JD's dominant signal", "compatibleWith": ["hybrid-balanced"] }
  },
  "conflictingChips": [
    { "pair": ["restrained", "narrative"], "kind": "length" },
    { "pair": ["factual", "narrative"], "kind": "form" },
    { "pair": ["quantified", "narrative"], "kind": "form" },
    { "pair": ["outcome-led", "method-led"], "kind": "ordering" },
    { "pair": ["polished", "restrained"], "kind": "register" }
  ],
