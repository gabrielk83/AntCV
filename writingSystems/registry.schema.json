{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AntCV Writing System Registry",
  "description": "Twelve canonical writing styles per docs/design/Writing_System_Engine_Specification.docx + plan §4. Five active at v1.50.0 cut.",
  "type": "object",
  "required": ["version", "default", "styles", "toneChipsCatalogue", "sharedBannedBases"],
  "properties": {
    "version": { "type": "string" },
    "default": { "type": "string" },
    "activeAtCut": { "type": "array", "items": { "type": "string" } },
    "densityTiers": { "type": "object" },
    "styles": { "type": "object", "additionalProperties": { "$ref": "#/$defs/Style" } },
    "toneChipsCatalogue": { "type": "object" },
    "conflictingChips": { "type": "array" },
    "supportedLanguages": { "type": "array", "items": { "type": "string" } },
    "sharedBannedBases": { "$ref": "#/$defs/SharedBannedBases" },
    "integrityRules": { "type": "array" },
    "matching": { "type": "object" },
    "sectionFormatTaxonomy": { "type": "array" }
  },
  "$defs": {
    "Range": {
      "type": "object",
      "required": ["min", "max"],
      "properties": { "min": { "type": "integer" }, "max": { "type": "integer" } }
    },
    "Style": {
      "type": "object",
      "required": ["displayName", "active", "primaryConstraint", "defaultToneChips", "lineDensity", "wordsPerBullet", "profileChars", "allowedLength"],
      "properties": {
        "displayName": { "type": "string" },
        "active": { "type": "boolean" },
        "comingInRelease": { "type": "string" },
        "primaryConstraint": { "type": "string" },
        "constraintAvoid": { "type": "string" },
        "constraintPrefer": { "type": "string" },
        "defaultToneChips": { "type": "array", "items": { "type": "string" } },
        "lineDensity": { "type": "string", "enum": ["low", "medium", "medium-high", "high"] },
        "wordsPerBullet": { "$ref": "#/$defs/Range" },
        "profileChars": { "$ref": "#/$defs/Range" },
        "allowedLength": { "$ref": "#/$defs/Range" },
        "sectionFormatDefaults": { "type": "object" },
        "atsBehavior": { "type": "string" },
        "compressionTolerance": { "type": "string" },
        "contentRule": { "type": "string" },
        "avoidRule": { "type": "string" },
        "preserveCompressPriority": { "type": "array" },
        "recommendedPairings": { "type": "object" },
        "pairedSeniority": { "type": "array" },
        "legacyAliases": { "type": "array" },
        "glyphDensity": { "type": "string" },
        "glyphNotes": { "type": "string" },
        "exportInstruction": { "type": "string" },
        "sectionOrder": { "type": "array" }
      }
    },
    "SharedBannedBases": {
      "type": "object",
      "required": ["words", "phrases"],
      "properties": {
        "words": {
          "type": "object",
          "properties": {
            "en": { "type": "array", "items": { "type": "string" } },
            "da": { "type": "array", "items": { "type": "string" } },
            "es": { "type": "array", "items": { "type": "string" } },
            "zh": { "type": "array", "items": { "type": "string" } }
          }
        },
        "phrases": {
          "type": "object",
          "properties": {
            "en": { "type": "array", "items": { "type": "string" } },
            "da": { "type": "array", "items": { "type": "string" } },
            "es": { "type": "array", "items": { "type": "string" } },
            "zh": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    }
  }
}
